# Copy to ~/.ha_trader/.env on the server and `chmod 600` it. NEVER commit the real file.

# Kite Connect app (developers.kite.trade)
KITE_API_KEY=
KITE_API_SECRET=

# Zerodha login used for the automated daily login
KITE_USER_ID=
KITE_PASSWORD=
# The base32 secret shown when you set up external TOTP in Kite
# (Kite > My profile > Password & Security > 2FA > "Can't scan? Copy the key")
KITE_TOTP_SECRET=

# Trade settings
HA_LOTS=1
# Entry is always: stock LTP >= previous day's close + 0.5% (HA_ENTRY is no longer used)

# Optional: email notifications (same Gmail app password as the screener)
EMAIL_USERNAME=
EMAIL_APP_PASSWORD=
EMAIL_TO=
